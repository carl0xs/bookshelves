<Layouts.app flash={@flash}>
  <div class="px-4">
    <div class="mx-auto max-w-xl lg:mx-0 mb-3">
      <.form for={%{}} phx-submit="search" class="flex gap-5">
        <input
          class="w-xl h-10 rounded-md p-4 border bg-white text-black"
          placeholder="search book"
          name="title"
        />
      </.form>
    </div>
    <div class="searching-container">
      <ul>
        <%= for register <- @result do %>
          <li class="flex gap-2">
            <img
              class="reading-search-img mb-3"
              src={register.thumbnail}
              name={register.title}
              phx-click="select_book"
              phx-value-id={register.id}
            />
            <div>
              <span class="text-[11px] block">{register.title}</span>
              <span class="text-[11px] block">by {register.authors}</span>
              <span class="text-[11px] block">published at: {register.published_at}</span>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <h4 class="font-bold">Current Reads</h4>
  <.modal
    id="book-modal"
    show={@show_modal}
    on_cancel={JS.push("close_modal")}
  >
    <div class="flex space-y-4 gap-2">
      <img src={@selected_book.thumbnail} class="w-32" />

      <div>
        <span class="text-black block">
          {@selected_book.title}
        </span>
        <span class="text-black block">
          by {@selected_book.authors}
        </span>
        <span class="text-black block text-[10px]">
          {@selected_book.description}
        </span>
      </div>

      <%= unless @selected_book |> Map.get(:status) do %>
      <% else %>
        <.form
          for={%{}}
          phx-change="update_status"
        >
          <input
            type="hidden"
            name="id"
            value={@selected_book.id}
          />

          <select name="status">
            <option
              value="want_read"
              selected={@selected_book.status == :want_read}
            >
              Want Read
            </option>

            <option
              value="reading"
              selected={@selected_book.status == :reading}
            >
              Reading
            </option>

            <option
              value="droped"
              selected={@selected_book.status == :droped}
            >
              Dropped
            </option>

            <option
              value="readed"
              selected={@selected_book.status == :readed}
            >
              Read
            </option>
          </select>
        </.form>
      <% end %>
    </div>
    <div>
    <%= unless @selected_book |> Map.get(:status) do %>
      <button
        phx-click="save_book"
        class="rounded bg-blue-600 px-4 py-2 text-white"
      >
        Add to Bookshelvs 
      </button>
    <% else %>
    <% end %>
    </div>
  </.modal>
  <div class="flex gap-2">
    <span>
      <.icon name="hero-bookmark-square" />
    </span>
    <span>{length(@readings)} obras</span>
  </div>

  <div class="grid grid-cols-6 gap-12">
    <.modal
      id="book-modal"
      show={@show_modal_progress}
      on_cancel={JS.push("close_modal_progress")}
      class="w-[250px]"
    >
      <div class="flex space-y-4 gap-2">
        <div>
          <span class="text-black block">
            {@selected_book.title}
          </span>
          <.form for={%{}} phx-submit="update_progress">
            <input class="bg-white text-black" type="text" name="progress" />
            <span>#{@selected_book.total_pages}</span>
            <button class="flex pt-3" type="submit">Salvar</button>
          </.form>
        </div>
      </div>
    </.modal>
    <%= for reading <- @readings do %>
      <div>
        <div class="image-container">
          <img
            class="reading-img"
            src={reading.thumbnail}
            title={reading.title}
            phx-click="select_book"
            phx-value-id={reading.id}
          />
          <button class="btn-update-status" phx-click="open_modal_progress" phx-value-id={reading.id}>
            <.icon name="hero-bars-3" />
          </button>
          <span class="badge">{reading.status}</span>
        </div>
        <div class="w-[200px]">
          <span class="text-[12px]">{reading.current_page} / {reading.total_pages} ({Reading.progress(reading)}%)</span>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
