<Layouts.app flash={@flash}>
  <div class="mt-8">
    <BookComponents.search_form query={@query} />
    <BookComponents.search_results results={@result} can_load_more={@can_load_more} />
  </div>

  <BookComponents.shelf_filters
    status_filter={@status_filter}
    media_filter={@media_filter}
    count={length(@filtered_readings)}
  />
  <BookComponents.shelf_grid readings={@filtered_readings} />

  <%= if @selected_book do %>
    <BookComponents.book_detail_modal
      book={@selected_book}
      show={@show_modal}
      mode={@modal_mode}
      draft_status={@draft_status}
      draft_page={@draft_page}
      draft_progress={@draft_progress}
      draft_tag={@draft_tag}
    />
  <% end %>
</Layouts.app>
